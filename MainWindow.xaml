<Window x:Class="CrosshairAlt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Crosshair Alt" Icon="app.ico"
        Width="1120" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource TextNormal}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46"
                        CornerRadius="12"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="RootFrame"
          CornerRadius="12"
          Background="{DynamicResource BgWindowBrush}"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="42"/>
      </Grid.RowDefinitions>

      <!-- TOP BAR -->
      <Border x:Name="TopBarBorder" Grid.Row="0"
              CornerRadius="12,12,0,0"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrushMain}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
        <Grid Margin="16,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Brand -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/app.ico"
                   Width="22" Height="22"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Crosshair Alt" FontSize="14.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextNormal}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border Background="{DynamicResource BgControlBrush}"
                    BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="1"
                    CornerRadius="6" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="v1.0.0" FontSize="10.5" FontWeight="Bold"
                         Foreground="{DynamicResource AccentHighlightBrush}"/>
            </Border>
          </StackPanel>

          <!-- Navigation Tabs -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
            <Button x:Name="BtnTabCrosshair" Content="Crosshair"
                    Style="{StaticResource ActiveNavTabButtonStyle}"
                    Click="BtnTabCrosshair_Click" Margin="0,0,6,0"/>
            <Button x:Name="BtnTabOptions" Content="Options &amp; Hotkeys"
                    Style="{StaticResource NavTabButtonStyle}"
                    Click="BtnTabOptions_Click"/>
          </StackPanel>

          <!-- Live Crosshair Status Pill -->
          <Button x:Name="BtnTopbarCrosshairPill" Grid.Column="3"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="BtnTopbarCrosshairPill_Click"
                  Cursor="Hand" Height="26" Padding="11,0" Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  ToolTip="Click to toggle crosshair overlay">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="PillBd"
                        Background="{DynamicResource BgControlBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{TemplateBinding Foreground}" Margin="0,0,7,0"/>
                    <TextBlock Text="{TemplateBinding Content}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>

          <!-- Caption Controls -->
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch">
            <Button x:Name="BtnMinimize" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="BtnMinimize_Click" ToolTip="Minimize"/>
            <Button x:Name="BtnMaximize" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Style="{StaticResource WindowCaptionButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="BtnMaximize_Click" ToolTip="Maximize / Restore"/>
            <Button x:Name="BtnClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Style="{StaticResource WindowCaptionCloseButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="BtnClose_Click" ToolTip="Close"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- MAIN STAGE -->
      <Grid Grid.Row="1">

        <!-- VIEW 1: CROSSHAIR STUDIO -->
        <Grid x:Name="CrosshairView" Visibility="Visible" Margin="18,16,18,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Left Column: Preview, Profiles, Valorant Import -->
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>

              <!-- Preview Card -->
              <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource Section}" Text="LIVE PREVIEW" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <RadioButton x:Name="BgSky" Style="{StaticResource Chip}" GroupName="PreviewBg" Content="Sky" IsChecked="True" Padding="8,2" FontSize="11"/>
                      <RadioButton x:Name="BgDark" Style="{StaticResource Chip}" GroupName="PreviewBg" Content="Dark" Padding="8,2" FontSize="11"/>
                      <RadioButton x:Name="BgLight" Style="{StaticResource Chip}" GroupName="PreviewBg" Content="Light" Margin="0" Padding="8,2" FontSize="11"/>
                    </StackPanel>
                  </Grid>

                  <Border x:Name="PreviewBackdrop" Height="215" CornerRadius="10" ClipToBounds="True"
                          BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="1" Margin="0,0,0,12">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3B4A5C" Offset="0"/>
                        <GradientStop Color="#6E7264" Offset="0.55"/>
                        <GradientStop Color="#2E2B26" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                  </Border>

                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <RadioButton x:Name="Zoom1" Style="{StaticResource Chip}" GroupName="Zoom" Content="1x"/>
                    <RadioButton x:Name="Zoom4" Style="{StaticResource Chip}" GroupName="Zoom" Content="4x" IsChecked="True"/>
                    <RadioButton x:Name="Zoom8" Style="{StaticResource Chip}" GroupName="Zoom" Content="8x" Margin="0"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Profiles Card -->
              <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Style="{StaticResource Section}" Text="PROFILES" Margin="0,0,0,10"/>
                  <WrapPanel x:Name="ProfilePanel" Margin="0,0,0,6"/>
                  <DockPanel Margin="0,4,0,0">
                    <Button x:Name="DeleteProfileButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}"
                            Content="Delete" Margin="6,0,0,0" Padding="10,6"/>
                    <Button x:Name="SaveProfileButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                            Content="Save" Margin="6,0,0,0" Padding="10,6"/>
                    <TextBox x:Name="ProfileName" FontFamily="Segoe UI Variable Text, Segoe UI"
                             ToolTip="Profile name"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                             Text="Enter a name and click Save. Using an existing name overwrites that profile."/>
                </StackPanel>
              </Border>

              <!-- Valorant Import Card -->
              <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                  <TextBlock Style="{StaticResource Section}" Text="IMPORT VALORANT CODE" Margin="0,0,0,10"/>
                  <DockPanel>
                    <Button x:Name="ImportButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="Import" Margin="8,0,0,0" Padding="14,6"/>
                    <TextBox x:Name="ValorantCodeBox" FontSize="12"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                             Text="In Valorant, go to Settings → Crosshair → Export Profile Code, paste it here, and click Import."/>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>

          <!-- Right Column: Crosshair Settings Cards (built in code) -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel x:Name="SettingsPanel"/>
          </ScrollViewer>
        </Grid>

        <!-- VIEW 2: OPTIONS & HOTKEYS -->
        <ScrollViewer x:Name="OptionsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
          <StackPanel MaxWidth="920">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Options &amp; Hotkeys" FontSize="22" FontWeight="Bold"
                         Foreground="{DynamicResource TextNormal}"/>
              <TextBlock Text="Configure global function keys, frosted glass blur appearance, tray behavior, and app info."
                         FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Hotkeys Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="GLOBAL FUNCTION KEYS &amp; HOTKEYS"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Click any key button and press a Function Key (F1–F12) or shortcut combination. Press Esc to cancel."/>
                  </StackPanel>
                  <Button x:Name="ResetHotkeysButton" Style="{StaticResource FlatButton}"
                          Content="Reset Defaults" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>

                <StackPanel x:Name="HotkeysListPanel" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- Appearance & Blur Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="FROSTED GLASS &amp; BLUR DESIGN" Margin="0,0,0,12"/>

                <TextBlock Text="Theme Palette" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="ThemeChipsPanel" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Backdrop Effect" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="BackdropChipsPanel" Orientation="Horizontal"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,6">
                      <TextBlock Text="Glass Transparency" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                      <TextBlock x:Name="TransparencyValueText" Text="50%" FontSize="12" FontWeight="Bold"
                                 Foreground="{DynamicResource AccentHighlightBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="TransparencySlider" Minimum="0" Maximum="85"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Behavior & About Grid -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Behavior Card -->
              <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel>
                  <TextBlock Style="{StaticResource Section}" Text="WINDOW &amp; TRAY BEHAVIOR" Margin="0,0,0,12"/>
                  <CheckBox x:Name="MinimizeToTraySwitch" Style="{StaticResource Switch}"
                            Content="Minimize to system tray when closing" Margin="0,0,0,12"/>
                  <CheckBox x:Name="StartMinimizedSwitch" Style="{StaticResource Switch}"
                            Content="Start minimized to system tray" Margin="0,0,0,12"/>
                  <CheckBox x:Name="LaunchAtStartupSwitch" Style="{StaticResource Switch}"
                            Content="Launch at Windows startup"/>
                </StackPanel>
              </Border>

              <!-- About & License Card -->
              <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel>
                  <TextBlock Style="{StaticResource Section}" Text="ABOUT &amp; LICENSE" Margin="0,0,0,10"/>
                  <TextBlock Text="Crosshair Alt v1.0.0" FontSize="15" FontWeight="Bold"
                             Foreground="{DynamicResource TextNormal}"/>
                  <TextBlock Text="MIT License — Copyright (c) 2026 Bishpop" FontSize="12"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,10"/>
                  <TextBlock x:Name="ConfigPathText" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenConfigFolderButton" Style="{StaticResource FlatButton}"
                            Content="Open Config Folder" Margin="0,0,8,0"/>
                    <Button x:Name="ExitAppButton" Style="{StaticResource DangerButton}"
                            Content="Exit App"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

          </StackPanel>
        </ScrollViewer>

      </Grid>

      <!-- FOOTER BAR -->
      <Border x:Name="FooterBorder" Grid.Row="2"
              CornerRadius="0,0,12,12"
              Background="{DynamicResource BgPanelBrush}"
              BorderBrush="{DynamicResource BorderBrushMain}"
              BorderThickness="0,1,0,0"
              Padding="18,0">
        <DockPanel>
          <Button x:Name="TrayButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                  Content="Hide to Tray" Padding="14,5" VerticalAlignment="Center"/>
          <TextBlock x:Name="HotkeyHintText" DockPanel.Dock="Right" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,16,0"/>
          <CheckBox x:Name="VisibleSwitch" DockPanel.Dock="Left" Style="{StaticResource Switch}"
                    Content="Show Crosshair" Margin="0,0,18,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0"/>
        </DockPanel>
      </Border>

      <!-- Crisp Anti-Aliased Glass Rim Overlay -->
      <Border x:Name="OuterGlassRim" Grid.RowSpan="3" CornerRadius="12"
              BorderThickness="1" BorderBrush="{DynamicResource WindowBorderBrush}"
              IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
