<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CrosshairAlt</AssemblyName>
    <RootNamespace>CrosshairAlt</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Crosshair Alt</Product>
    <Title>Crosshair Alt</Title>
    <Authors>Bishpop</Authors>
    <Company>Bishpop</Company>
    <Copyright>Copyright (c) 2026 Bishpop</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
